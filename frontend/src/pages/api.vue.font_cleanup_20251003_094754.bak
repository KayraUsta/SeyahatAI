            @click="showFavorites = !showFavorites"
            :outline="!showFavorites"
          />
        </q-card-actions>
      </q-card>
    </q-dialog>

    <q-dialog v-model="registerDialog" persistent>
      <q-card class="auth-modal register-modal glass-effect-enhanced" dark style="min-width: 400px">
