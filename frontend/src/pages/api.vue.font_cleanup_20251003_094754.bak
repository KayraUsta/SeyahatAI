}

.plan-date-modern {
  font-size: 0.85rem;
  color: #9ca3af;
  display: flex;
  align-items: center;
  gap: 4px;
}

.favorite-btn-modern {
  transition: all 0.3s ease;
}

.favorite-btn-modern:hover {
  transform: scale(1.3) rotate(15deg);
}

.plan-card-middle {
  padding: 20px 24px;
  min-height: 90px;
  background: rgba(0, 0, 0, 0.15);
}

.plan-query-modern {
  font-size: 0.95rem;
