          >
            <template v-slot:prepend>
              <q-icon name="person" color="accent" />
            </template>
          </q-input>

          <q-input
            v-model="registerEmail"
            outlined
            dark
            label="Email"
            type="email"
            class="q-mb-md custom-input-enhanced"
            :rules="[val => !!val || 'Email gereklidir']"
          >
