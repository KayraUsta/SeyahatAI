              class="q-mb-lg custom-input-enhanced"
              :disable="isLoading"
            >
              <template v-slot:prepend>
                <q-icon name="search" color="accent" class="pulse-icon" />
               </template>
              <template v-slot:append>
                <q-icon name="explore" color="secondary" />
